---
import TrustSignals from "../components/TrustSignals.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
    title: string;
    description?: string;
}

const {
    title,
    description = "Decants de 5 ml y perfumes árabes originales en Chile. Prueba antes de comprar la botella y coordina tu pedido por WhatsApp.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/jpeg" href="/images/logo.jpg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="theme-color" content="#1c120c" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Essenciarabe" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content="/images/crimson.jpg" />
        <meta property="og:locale" content="es_CL" />
        <meta name="twitter:card" content="summary_large_image" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..800&display=swap"
            rel="stylesheet"
        />
        <ClientRouter />
    </head>
    <body>
        <a class="skip-link" href="#contenido">Saltar al contenido</a>
        <slot />
        <TrustSignals />

        <script>
            import {
                addToCart,
                isCartOpen,
                cartItems,
                closeCart,
                removeFromCart,
                updateQuantity,
                toggleCart,
                clearCart,
            } from "../store/cartStore";

            let cartSubscriptions: any[] = [];
            let lastFocused: HTMLElement | null = null;
            let toastTimer: number | undefined;

            function escapeHtml(value: unknown): string {
                return String(value ?? "").replace(
                    /[&<>"'`]/g,
                    (char) =>
                        ({
                            "&": "&amp;",
                            "<": "&lt;",
                            ">": "&gt;",
                            '"': "&quot;",
                            "'": "&#39;",
                            "`": "&#96;",
                        })[char] as string,
                );
            }

            function money(value: number): string {
                return `$${value.toLocaleString("es-CL")}`;
            }

            function setup() {
                cartSubscriptions.forEach((unsubscribe) => unsubscribe());
                cartSubscriptions = [];

                const oldHandler = (window as any).cartClickHandler;
                if (oldHandler) {
                    document.removeEventListener("click", oldHandler);
                }

                (window as any).cartClickHandler = function (e: Event) {
                    const target = e.target as HTMLElement | null;
                    const button = target?.closest(
                        ".add-to-cart-btn",
                    ) as HTMLButtonElement | null;

                    if (!button || button.disabled) return;

                    e.preventDefault();

                    const id = button.dataset.id || button.dataset.name;
                    const name = button.dataset.name;
                    const price = parseFloat(button.dataset.price || "0");
                    const image = button.dataset.image;
                    const brand = button.dataset.brand;

                    if (!id || !name || !(price > 0)) return;

                    addToCart({
                        id,
                        name,
                        price,
                        image: image || "",
                        brand: brand || "",
                    });

                    stampAdded(button);
                };

                document.addEventListener(
                    "click",
                    (window as any).cartClickHandler,
                );

                setupCart();
                setupNavbar();
                setupMarks();
                setupTrail();
            }

            // El estado "añadido" es una marca momentánea, no un cambio de color.
            function stampAdded(button: HTMLButtonElement) {
                const plus = button.querySelector(".icon-plus");
                const check = button.querySelector(".icon-check");
                const rest = button.dataset.labelRest;

                button.dataset.added = "true";
                plus?.classList.add("hidden");
                check?.classList.remove("hidden");
                if (rest) button.textContent = "En el carrito";

                window.setTimeout(() => {
                    delete button.dataset.added;
                    plus?.classList.remove("hidden");
                    check?.classList.add("hidden");
                    if (rest) button.textContent = rest;
                }, 1400);

                showToast();
            }

            function showToast() {
                const toast = document.getElementById("stamp-toast");
                const countEl = document.getElementById("stamp-toast-count");
                if (!toast) return;

                const total = Object.values(cartItems.get()).reduce(
                    (acc, item) => acc + item.quantity,
                    0,
                );
                if (countEl) countEl.textContent = String(total);

                toast.classList.remove("hidden");
                toast.classList.add("flex");

                if (toastTimer) window.clearTimeout(toastTimer);
                toastTimer = window.setTimeout(hideToast, 3200);
            }

            function hideToast() {
                const toast = document.getElementById("stamp-toast");
                if (!toast) return;
                toast.classList.add("hidden");
                toast.classList.remove("flex");
            }

            function setupNavbar() {
                const btn = document.querySelector("#cart-btn");
                const mobileMenuBtn = document.querySelector("#mobile-menu-btn");
                const mobileMenu = document.querySelector(
                    "#mobile-menu",
                ) as HTMLElement | null;
                const menuIcon = document.querySelector("#menu-icon");
                const closeIcon = document.querySelector("#close-icon");
                const mobileItems = document.querySelectorAll(".mobile-li");

                if (!btn) return;

                // Clonar para descartar listeners de la página anterior.
                const newBtn = btn.cloneNode(true) as HTMLElement;
                btn.parentNode?.replaceChild(newBtn, btn);

                let newMobileBtn = mobileMenuBtn;
                if (mobileMenuBtn) {
                    newMobileBtn = mobileMenuBtn.cloneNode(true) as HTMLElement;
                    mobileMenuBtn.parentNode?.replaceChild(
                        newMobileBtn,
                        mobileMenuBtn,
                    );
                }

                function closeMenu() {
                    mobileMenu?.classList.add(
                        "opacity-0",
                        "pointer-events-none",
                    );
                    document.body.style.overflow = "";
                    newMobileBtn?.setAttribute("aria-expanded", "false");
                    window.setTimeout(() => {
                        mobileMenu?.classList.add("hidden");
                        mobileItems.forEach((item) => {
                            item.classList.add("translate-y-4", "opacity-0");
                        });
                    }, 300);
                    menuIcon?.classList.remove("hidden");
                    closeIcon?.classList.add("hidden");
                }

                function openMenu() {
                    mobileMenu?.classList.remove("hidden");
                    document.body.style.overflow = "hidden";
                    newMobileBtn?.setAttribute("aria-expanded", "true");
                    window.setTimeout(() => {
                        mobileMenu?.classList.remove(
                            "opacity-0",
                            "pointer-events-none",
                        );
                        mobileItems.forEach((item) => {
                            item.classList.remove(
                                "translate-y-4",
                                "opacity-0",
                            );
                        });
                    }, 10);
                    menuIcon?.classList.add("hidden");
                    closeIcon?.classList.remove("hidden");
                }

                newBtn.addEventListener("click", () => {
                    toggleCart();
                    if (mobileMenu && !mobileMenu.classList.contains("hidden")) {
                        closeMenu();
                    }
                });

                newMobileBtn?.addEventListener("click", () => {
                    const isOpen =
                        !mobileMenu?.classList.contains("hidden") &&
                        !mobileMenu?.classList.contains("opacity-0");

                    if (isOpen) closeMenu();
                    else openMenu();
                });

                mobileItems.forEach((item) => {
                    item.addEventListener("click", () => closeMenu());
                });

                const countEl = newBtn.querySelector("#cart-count");
                const countSub = cartItems.subscribe((items) => {
                    const total = Object.values(items).reduce(
                        (acc, item) => acc + item.quantity,
                        0,
                    );
                    if (!countEl) return;
                    countEl.textContent = total.toString();
                    countEl.classList.toggle("hidden", total === 0);
                });

                cartSubscriptions.push(countSub);
            }

            function setupCart() {
                const drawer = document.getElementById("cart-drawer");
                const overlay = document.getElementById(
                    "cart-drawer-overlay",
                );
                const closeBtn = document.getElementById("close-cart");
                const keepShoppingBtn =
                    document.getElementById("keep-shopping");
                const cartList = document.getElementById("cart-list");
                const emptyMessage = document.getElementById(
                    "empty-cart-message",
                );
                const subtotalEl = document.getElementById("cart-subtotal");
                const checkoutBtn = document.getElementById(
                    "checkout-btn",
                ) as HTMLButtonElement | null;
                const clearCartBtn = document.getElementById(
                    "clear-cart-btn",
                ) as HTMLButtonElement | null;

                if (!drawer) return;

                const PHONE_NUMBER = "56965390562";

                function handleCheckout() {
                    const items = Object.values(cartItems.get());
                    if (items.length === 0) return;

                    let total = 0;
                    let message =
                        "¡Hola! Quiero encargar estos decants:\n\n";

                    items.forEach((item) => {
                        message += `- ${item.name} (${item.brand}) x${item.quantity}: $${(
                            item.price * item.quantity
                        ).toLocaleString("es-CL")}\n`;
                        total += item.price * item.quantity;
                    });

                    message += `\n*TOTAL: $${total.toLocaleString("es-CL")}*`;
                    message += "\n\n¿Coordinamos la entrega?";
                    window.open(
                        `https://wa.me/${PHONE_NUMBER}?text=${encodeURIComponent(message)}`,
                        "_blank",
                    );
                }

                checkoutBtn?.addEventListener("click", handleCheckout);
                clearCartBtn?.addEventListener("click", () => clearCart());
                closeBtn?.addEventListener("click", () => closeCart());
                overlay?.addEventListener("click", () => closeCart());
                keepShoppingBtn?.addEventListener("click", () => closeCart());
                document
                    .getElementById("stamp-toast")
                    ?.addEventListener("click", () => {
                        hideToast();
                        toggleCart();
                    });

                const openSub = isCartOpen.subscribe((open) => {
                    drawer.classList.toggle("translate-y-full", !open);
                    overlay?.classList.toggle("opacity-0", !open);
                    overlay?.classList.toggle("pointer-events-none", !open);
                    drawer.setAttribute("aria-hidden", String(!open));
                    (drawer as HTMLElement).inert = !open;
                    document.body.style.overflow = open ? "hidden" : "";

                    if (open) {
                        drawer.classList.remove("invisible");
                        hideToast();
                    } else {
                        window.setTimeout(() => {
                            if (!isCartOpen.get()) {
                                drawer.classList.add("invisible");
                            }
                        }, 520);
                    }

                    const cartBtn = document.querySelector("#cart-btn");
                    cartBtn?.setAttribute("aria-expanded", String(open));

                    if (open) {
                        lastFocused = document.activeElement as HTMLElement;
                        window.requestAnimationFrame(() =>
                            (closeBtn as HTMLElement | null)?.focus(),
                        );
                    } else {
                        if (lastFocused && lastFocused !== document.body) {
                            lastFocused.focus();
                        } else {
                            document
                                .querySelector<HTMLElement>("#cart-btn")
                                ?.focus();
                        }
                        lastFocused = null;
                    }
                });

                let lastCartState: Record<string, any> = {};
                const itemsSub = cartItems.subscribe((items) => {
                    const itemsArray = Object.values(items);
                    const hasItems = itemsArray.length > 0;

                    emptyMessage?.classList.toggle("hidden", hasItems);
                    emptyMessage?.classList.toggle("flex", !hasItems);
                    cartList?.classList.toggle("hidden", !hasItems);

                    if (checkoutBtn) checkoutBtn.disabled = !hasItems;
                    if (clearCartBtn) clearCartBtn.disabled = !hasItems;

                    if (!hasItems) {
                        if (subtotalEl) subtotalEl.textContent = "$0";
                        lastCartState = {};
                        return;
                    }

                    let total = 0;
                    if (cartList) {
                        const currentIds = new Set(
                            itemsArray.map((item) => item.id),
                        );
                        const lastIds = new Set(Object.keys(lastCartState));
                        const needsFullRegen =
                            currentIds.size !== lastIds.size ||
                            [...currentIds].some((id) => !lastIds.has(id)) ||
                            [...lastIds].some((id) => !currentIds.has(id));

                        if (needsFullRegen) {
                            cartList.innerHTML = itemsArray
                                .map((item) => {
                                    total += item.price * item.quantity;
                                    const safeId = escapeHtml(item.id);
                                    const safeImage = escapeHtml(item.image);
                                    const safeName = escapeHtml(item.name);
                                    const safeBrand = escapeHtml(item.brand);
                                    return `
                          <li class="flex gap-3 border-b border-ink/20 py-3" data-item-id="${safeId}">
                            <div class="plate h-16 w-14 shrink-0 border border-ink/25" style="--field:#dcbb92">
                              <img src="${safeImage}" alt="${safeName}">
                            </div>
                            <div class="flex min-w-0 flex-1 flex-col">
                              <div class="flex items-start justify-between gap-3">
                                <div class="min-w-0">
                                  <p class="label text-ink-soft">${safeBrand}</p>
                                  <p class="display mt-1 truncate text-[1rem] text-ink">${safeName}</p>
                                </div>
                                <p class="price item-total-price whitespace-nowrap text-[1rem] text-ink">${money(item.price * item.quantity)}</p>
                              </div>
                              <div class="mt-2 flex items-center justify-between">
                                <div class="flex items-center border border-ink/30">
                                  <button type="button" class="qty-btn dec flex h-7 w-7 items-center justify-center text-ink transition-colors hover:bg-ink hover:text-kraft" data-id="${safeId}" aria-label="Quitar uno de ${safeName}">−</button>
                                  <span class="w-8 text-center text-sm font-semibold text-ink item-quantity">${item.quantity}</span>
                                  <button type="button" class="qty-btn inc flex h-7 w-7 items-center justify-center text-ink transition-colors hover:bg-ink hover:text-kraft" data-id="${safeId}" aria-label="Agregar uno de ${safeName}">+</button>
                                </div>
                                <button type="button" class="remove-btn text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-soft underline underline-offset-4 hover:text-stamp-deep" data-id="${safeId}">Quitar</button>
                              </div>
                            </div>
                          </li>
                        `;
                                })
                                .join("");

                            setupCartEventListeners(items);
                        } else {
                            itemsArray.forEach((item) => {
                                total += item.price * item.quantity;
                                const lastItem = lastCartState[item.id];

                                if (
                                    !lastItem ||
                                    lastItem.quantity !== item.quantity
                                ) {
                                    const quantityEl = cartList.querySelector(
                                        `li[data-item-id="${item.id}"] .item-quantity`,
                                    );
                                    if (quantityEl) {
                                        quantityEl.textContent =
                                            item.quantity.toString();
                                    }

                                    const priceEl = cartList.querySelector(
                                        `li[data-item-id="${item.id}"] .item-total-price`,
                                    );
                                    if (priceEl) {
                                        priceEl.textContent = money(
                                            item.price * item.quantity,
                                        );
                                    }
                                }
                            });
                        }
                    }

                    if (subtotalEl) subtotalEl.textContent = money(total);
                    lastCartState = { ...items };
                });

                function setupCartEventListeners(items: Record<string, any>) {
                    document.querySelectorAll(".remove-btn").forEach((btn) => {
                        btn.addEventListener("click", (e) => {
                            const target = e.currentTarget as HTMLElement;
                            const id = target.dataset.id;
                            if (id) removeFromCart(id);
                        });
                    });

                    document.querySelectorAll(".qty-btn").forEach((btn) => {
                        btn.addEventListener("click", (e) => {
                            const target = e.currentTarget as HTMLElement;
                            const id = target.dataset.id;
                            if (!id) return;

                            const currentItem = items[id];
                            if (!currentItem) return;

                            if (target.classList.contains("inc")) {
                                updateQuantity(id, currentItem.quantity + 1);
                            } else {
                                updateQuantity(id, currentItem.quantity - 1);
                            }
                        });
                    });
                }

                cartSubscriptions.push(openSub, itemsSub);
            }

            // Marca las fichas que ya están en el carrito (estado, no color).
            function setupMarks() {
                const sub = cartItems.subscribe((items) => {
                    document
                        .querySelectorAll<HTMLElement>(".add-to-cart-btn")
                        .forEach((btn) => {
                            const id = btn.dataset.id;
                            if (!id) return;
                            if (items[id]) btn.dataset.inCart = "true";
                            else delete btn.dataset.inCart;
                        });
                });
                cartSubscriptions.push(sub);
            }

            // Estela: los últimos decants vistos se desvanecen detrás del actual.
            function setupTrail() {
                const el = document.querySelector(
                    "[data-trail]",
                ) as HTMLElement | null;
                if (!el) return;

                const current = {
                    id: el.dataset.current || "",
                    name: el.dataset.name || "",
                    brand: el.dataset.brand || "",
                    price: el.dataset.price || "",
                    image: el.dataset.image || "",
                };
                if (!current.id) return;

                const KEY = "recent_decants";
                let list: any[] = [];
                try {
                    list = JSON.parse(localStorage.getItem(KEY) || "[]");
                } catch {
                    list = [];
                }
                if (!Array.isArray(list)) list = [];

                const others = list
                    .filter(
                        (item) =>
                            item &&
                            item.id &&
                            item.id !== current.id &&
                            item.name,
                    )
                    .slice(0, 3);

                const wrap = el.querySelector("[data-trail-items]");
                if (wrap) {
                    if (others.length === 0) {
                        el.hidden = true;
                    } else {
                        el.hidden = false;
                        el.classList.remove("hidden");
                        wrap.innerHTML = others
                            .map((item, index) => {
                                const opacity = [1, 0.78, 0.58][index] ?? 0.5;
                                return `
                        <a href="/${escapeHtml(item.id)}" class="trail-item group flex items-center gap-3" style="opacity:${opacity}">
                          <div class="plate h-14 w-12 shrink-0 border border-brass/30" style="--field:#dcbb92">
                            <img src="${escapeHtml(item.image)}" alt="${escapeHtml(item.name)}">
                          </div>
                          <div class="min-w-0">
                            <p class="label text-brass">${escapeHtml(item.brand)}</p>
                            <p class="display mt-1 truncate text-[1rem] text-kraft">${escapeHtml(item.name)}</p>
                            <p class="text-[12px] text-smoke">${escapeHtml(item.price)}</p>
                          </div>
                        </a>
                      `;
                            })
                            .join("");
                    }
                }

                const next = [current, ...others].slice(0, 4);
                try {
                    localStorage.setItem(KEY, JSON.stringify(next));
                } catch {
                    /* modo privado: la estela simplemente no persiste */
                }
            }

            function setupKeyHandling() {
                if ((window as any).cartKeyHandler) return;
                (window as any).cartKeyHandler = true;

                document.addEventListener("keydown", (e) => {
                    if (!isCartOpen.get()) return;

                    if (e.key === "Escape") {
                        e.preventDefault();
                        closeCart();
                        return;
                    }

                    if (e.key !== "Tab") return;

                    const drawer = document.getElementById("cart-drawer");
                    if (!drawer) return;

                    const focusable = Array.from(
                        drawer.querySelectorAll<HTMLElement>(
                            'a[href], button:not([disabled]), input, [tabindex]:not([tabindex="-1"])',
                        ),
                    ).filter((node) => node.offsetParent !== null);
                    if (focusable.length === 0) return;

                    const first = focusable[0];
                    const last = focusable[focusable.length - 1];

                    if (e.shiftKey && document.activeElement === first) {
                        e.preventDefault();
                        last.focus();
                    } else if (
                        !e.shiftKey &&
                        document.activeElement === last
                    ) {
                        e.preventDefault();
                        first.focus();
                    }
                });
            }

            setup();
            setupKeyHandling();

            document.addEventListener("astro:page-load", () => {
                setup();
                setupKeyHandling();
            });
        </script>
    </body>
</html>
