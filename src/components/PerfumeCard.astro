---
interface Props {
    id?: string;
    name: string;
    brand: string;
    price: number;
    image: string;
    description?: string;
}

const { id, name, brand, price, image, description } = Astro.props;
const key = id || name;
const href = `/${key}`;

// Una sola noche, varias temperaturas: el campo de cada ficha cambia de
// tono de ámbar según el producto, sin salir de la misma luz.
const fields = ["#dcbb92", "#d8a888", "#e2c79c", "#cfa87f", "#e0b98e"];
let hash = 0;
for (const char of String(key)) hash = (hash * 31 + char.charCodeAt(0)) % 997;
const field = fields[hash % fields.length];
---

<article
    class="paper stock-card group flex h-full flex-col"
    style={`--field:${field}`}
>
    <a href={href} class="flex grow flex-col">
        <div class="plate aspect-square w-full">
            <img
                src={image}
                alt={name}
                loading="lazy"
                transition:name={key}
            />
        </div>

        <div class="flex grow flex-col px-3.5 pb-3 pt-3">
            <div class="flex items-center justify-between gap-2">
                <p class="label text-ink-soft">{brand}</p>
                <span class="unit-chip">5 ml</span>
            </div>
            <h3 class="display mt-1.5 text-[1.25rem] text-ink">{name}</h3>
            {
                description && (
                    <p class="mt-2 line-clamp-2 text-[12px] leading-snug text-ink-soft">
                        {description}
                    </p>
                )
            }
        </div>
    </a>

    <div
        class="mt-auto flex items-end justify-between gap-2 border-t border-ink/25 px-3.5 py-2.5"
    >
        <span class="price text-[1.5rem] text-ink"
            >${price.toLocaleString("es-CL")}</span
        >

        <!--
            Fuera del <a>: anidar un interactivo dentro de otro es HTML inválido
            y hacía que Cmd/Ctrl+click sobre "+" agregara al carrito.
        -->
        <button
            type="button"
            class="add-to-cart-btn flex h-10 w-10 shrink-0 cursor-pointer items-center justify-center border border-ink/40 text-ink transition-colors hover:border-ink hover:bg-ink hover:text-kraft"
            data-id={key}
            data-name={name}
            data-price={price}
            data-image={image}
            data-brand={brand}
            aria-label={`Agregar ${name} al carrito`}
        >
            <svg
                class="icon-plus"
                width="15"
                height="15"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                aria-hidden="true"
            >
                <path d="M8 2.5v11M2.5 8h11"></path>
            </svg>
            <svg
                class="icon-check hidden"
                width="15"
                height="15"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                aria-hidden="true"
            >
                <path d="M2.5 8.5l3.5 3.5 7.5-8"></path>
            </svg>
        </button>
    </div>
</article>
