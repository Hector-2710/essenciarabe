---
---

<div
    id="cart-drawer-overlay"
    class="fixed inset-0 z-[60] bg-resin/80 opacity-0 pointer-events-none transition-opacity duration-300"
>
</div>

<aside
    id="cart-drawer"
    class="sheet invisible fixed inset-x-0 bottom-0 z-[70] mx-auto flex max-h-[90dvh] w-full max-w-[620px] translate-y-full flex-col transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]"
    role="dialog"
    aria-modal="true"
    aria-labelledby="cart-title"
    aria-hidden="true"
    inert
>
    <div class="perforation mx-5 mt-3" aria-hidden="true"></div>

    <div class="flex items-start justify-between px-5 pb-3 pt-4">
        <div>
            <h2 id="cart-title" class="display text-[2rem] text-ink">Carrito</h2>
            <p class="mt-1 text-[14px] leading-tight text-ink-soft">
                Se envía por WhatsApp y coordinamos la entrega.
            </p>
        </div>
        <button
            id="close-cart"
            type="button"
            class="-mr-1 flex h-10 w-10 items-center justify-center border border-ink/30 text-ink transition-colors hover:border-ink hover:bg-ink hover:text-kraft"
            aria-label="Cerrar el carrito"
        >
            <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                aria-hidden="true"
            >
                <path d="M5 5l14 14M19 5L5 19"></path>
            </svg>
        </button>
    </div>

    <div class="perforation mx-5" aria-hidden="true"></div>

    <div class="flex-1 overflow-y-auto px-5 py-2">
        <div
            id="empty-cart-message"
            class="hidden flex-col items-start gap-3 py-10"
        >
            <p class="display text-[1.5rem] text-ink">Tu carrito está vacío.</p>
            <p class="max-w-[36ch] text-sm leading-relaxed text-ink-soft">
                Elige dos o tres decants, pruébalos, y después decides la
                botella.
            </p>
            <button
                id="keep-shopping"
                type="button"
                class="quiet-btn quiet-btn--ink mt-1"
                >Ver los decants</button
            >
        </div>
        <ul id="cart-list" class="hidden"></ul>
    </div>

    <div class="border-t border-ink/20 px-5 pb-5 pt-4" id="cart-footer">
        <div class="flex items-baseline justify-between">
            <span class="label text-ink-soft">Total</span>
            <span id="cart-subtotal" class="price text-[2rem] text-ink">$0</span>
        </div>
        <p class="mt-2 text-[12px] leading-snug text-ink-soft">
            Precios en pesos chilenos. La entrega se coordina por WhatsApp.
        </p>
        <button
            id="checkout-btn"
            type="button"
            class="stamp-btn mt-4 w-full"
        >
            Enviar el pedido por WhatsApp
        </button>
        <button
            id="clear-cart-btn"
            type="button"
            class="quiet-btn quiet-btn--ink mt-3 w-full justify-center"
        >
            Vaciar el carrito
        </button>
    </div>
</aside>

<button
    id="stamp-toast"
    type="button"
    class="paper fixed bottom-4 left-4 right-4 z-[65] hidden items-center justify-between gap-3 border-2 border-stamp-deep px-4 py-3 text-left shadow-xl sm:right-auto sm:min-w-[260px]"
    aria-live="polite"
>
    <span class="display text-[1rem] text-ink">En el carrito</span>
    <span class="flex items-baseline gap-2">
        <span id="stamp-toast-count" class="price text-[1.25rem] text-stamp-deep"
            >1</span
        >
        <span class="label text-ink-soft">Ver</span>
    </span>
</button>
