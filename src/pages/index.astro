---
import Layout from "../layouts/MainLayout.astro";
import Navbar from "../components/Navbar.astro";
import PerfumeCard from "../components/PerfumeCard.astro";
import { getCollection } from "astro:content";

const decantsList = await getCollection("decants");

const byId = (id: string) =>
    decantsList.find((product) => product.data.id === id);

// Producto del mostrador: el decant que ocupa el fold.
const heroDecant = byId("decant-crimson");

// La pieza de escala: el decant más barato del catálogo.
const spotlightDecant = byId("decant-imperium");

// Selección de la estantería del inicio.
const featuredIds = [
    "decant-khamrah-qahwa",
    "decant-9pm-elixir",
    "decant-club-de-nuit-sillage",
    "decant-asad",
    "decant-teriaq-intense",
    "decant-liquid-brun",
    "decant-vintage-radio",
    "decant-yeah-man",
];

const featured = featuredIds
    .map((id) => byId(id))
    .filter((product): product is NonNullable<typeof product> =>
        Boolean(product),
    );

const decantCount = decantsList.length;
const minDecant = Math.min(...decantsList.map((item) => item.data.price));
const maxDecant = Math.max(...decantsList.map((item) => item.data.price));

const clp = (value: number) => `$${value.toLocaleString("es-CL")}`;
---

<Layout
    title="Essenciarabe — Decants de 5 ml de perfumes árabes originales"
    description="Decants de 5 ml de perfumes árabes originales desde $2.490. Prueba antes de comprar la botella y coordina tu pedido por WhatsApp."
>
    <Navbar />

    <main id="contenido">
        <!-- El mostrador: la etiqueta de precio y la botella delante -->
        <section class="relative overflow-hidden bg-resin pb-8 lg:pb-12">
            <div
                class="wood absolute inset-x-0 bottom-0 h-28 lg:h-44"
                aria-hidden="true"
            >
            </div>

            <div class="relative mx-auto max-w-[1440px] px-4 sm:px-6">
                <div class="mt-5 flex flex-col lg:flex-row lg:items-start">
                    <div
                        class="paper slab relative z-10 w-full px-5 pb-7 pt-6 sm:px-8 sm:pb-9 sm:pt-8 lg:w-[74%] lg:pb-10"
                    >
                    <h1
                        class="display text-[clamp(2.5rem,8.2vw,7rem)] text-ink"
                    >
                        Huele antes<br />de comprar<br />la botella
                    </h1>

                    <div
                        class="my-6 h-px w-full bg-ink/25 lg:my-8"
                        aria-hidden="true"
                    >
                    </div>

                    <div class="flex flex-wrap items-end gap-x-10 gap-y-5">
                        <div>
                            <p class="label text-ink-soft">El decant</p>
                            <p
                                class="display mt-2 text-[clamp(3.2rem,8.4vw,6.6rem)] leading-[0.82] text-ink"
                            >
                                5 ml
                            </p>
                        </div>
                        <div>
                            <p class="label text-ink-soft">Desde</p>
                            <p
                                class="price mt-2 text-[clamp(2rem,5.2vw,3.9rem)] text-stamp-deep"
                            >
                                {clp(minDecant)}
                            </p>
                        </div>
                    </div>

                    <a href="/decants" class="stamp-btn mt-7 w-full sm:w-auto">
                        Ver los decants
                    </a>

                    <p
                        class="mt-5 max-w-[42ch] text-[14px] leading-relaxed text-ink-soft"
                    >
                        {decantCount} decants en stock, todos 100% originales.
                    </p>
                </div>

                {
                    heroDecant && (
                        <div
                            class="paper stock-card relative z-20 -mt-6 w-full max-w-[360px] mx-auto lg:absolute lg:-bottom-12 lg:right-[8%] lg:mt-0 lg:w-[350px] lg:max-w-none"
                        >
                            <a
                                href={`/${heroDecant.data.id}`}
                                class="group block"
                            >
                                <div class="plate aspect-[3/4] w-full">
                                    <img
                                        src={heroDecant.data.image}
                                        alt={heroDecant.data.name}
                                        transition:name={heroDecant.data.id}
                                        width="960"
                                        height="1280"
                                        fetchpriority="high"
                                    />
                                </div>
                                <div class="px-4 pb-3 pt-3">
                                    <div class="flex items-center justify-between gap-2">
                                        <p class="label text-ink-soft">
                                            {heroDecant.data.brand}
                                        </p>
                                        <span class="unit-chip">5 ml</span>
                                    </div>
                                    <h2 class="display mt-1 text-[1.5rem] text-ink">
                                        {heroDecant.data.name}
                                    </h2>
                                </div>
                            </a>
                            <div class="border-t border-ink/25 px-4 pb-4 pt-3">
                                <div class="flex items-baseline justify-between">
                                    <span class="label text-ink-soft">
                                        Precio
                                    </span>
                                    <span class="price text-[1.5rem] text-ink">
                                        {clp(heroDecant.data.price)}
                                    </span>
                                </div>
                            </div>
                        </div>
                    )
                }
                </div>
            </div>
        </section>

        <!-- La estantería -->
        <section class="mx-auto max-w-[1440px] px-4 pb-14 pt-6 sm:px-6 lg:pb-20 lg:pt-8">
            <div
                class="flex flex-wrap items-end justify-between gap-4 border-b border-brass/30 pb-4"
            >
                <h2 class="display text-[clamp(2rem,4.6vw,3.6rem)] text-kraft">
                    La estantería
                </h2>
                <div class="flex flex-wrap items-baseline gap-x-6 gap-y-2">
                    <p class="text-sm text-smoke">
                        <span class="font-semibold text-amber"
                            >{decantCount}</span
                        >
                        decants · {clp(minDecant)} a {clp(maxDecant)}
                    </p>
                    <a href="/decants" class="quiet-btn">Ver todos</a>
                </div>
            </div>

            <div
                class="mt-6 grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:grid-cols-4"
            >
                {
                    featured.map((product) => (
                        <PerfumeCard
                            id={product.data.id}
                            name={product.data.name}
                            brand={product.data.brand}
                            price={product.data.price}
                            image={product.data.image}
                            description={product.data.description}
                        />
                    ))
                }
            </div>
        </section>

        <!-- Qué es un decant -->
        {
            spotlightDecant && (
                <section class="border-y border-brass/25 bg-resin-soft">
                    <div class="mx-auto grid max-w-[1440px] items-center gap-8 px-4 py-14 sm:px-6 lg:grid-cols-[1.1fr_1fr] lg:gap-14 lg:py-20">
                        <div class="paper stock-card p-3 sm:p-4">
                            <div class="plate aspect-[4/5] w-full">
                                <img
                                    src={spotlightDecant.data.image}
                                    alt={spotlightDecant.data.name}
                                    transition:name={spotlightDecant.data.id}
                                    loading="lazy"
                                    width="960"
                                    height="1280"
                                />
                            </div>
                        </div>

                        <div>
                            <h2 class="display text-[clamp(2rem,5vw,4.2rem)] text-kraft">
                                Cinco mililitros<br />alcanzan para decidir.
                            </h2>

                            <p class="mt-5 max-w-[46ch] text-sm leading-relaxed text-smoke">
                                Un decant es el mismo perfume, servido en frascos sellados de 5 ml. Alcanza para varios usos y para comparar dos o tres fragancias antes de elegir una.
                            </p>

                            <div class="mt-8">
                                <div class="ledger-row">
                                    <span class="text-sm text-smoke">Tamaño</span>
                                    <span class="ledger-lead" aria-hidden="true" />
                                    <span class="price text-[1.5rem] text-kraft"
                                        >5 ml</span
                                    >
                                </div>
                                <div class="ledger-row">
                                    <span class="text-sm text-smoke">Precio</span>
                                    <span class="ledger-lead" aria-hidden="true" />
                                    <span class="price text-[1.5rem] text-amber"
                                        >{clp(spotlightDecant.data.price)}</span
                                    >
                                </div>
                                <div class="ledger-row">
                                    <span class="text-sm text-smoke">En stock</span>
                                    <span class="ledger-lead" aria-hidden="true" />
                                    <span class="price text-[1.5rem] text-kraft"
                                        >{decantCount}</span
                                    >
                                </div>
                            </div>

                            <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center">
                                <button
                                    type="button"
                                    class="add-to-cart-btn stamp-btn"
                                    data-id={spotlightDecant.data.id}
                                    data-name={spotlightDecant.data.name}
                                    data-price={spotlightDecant.data.price}
                                    data-image={spotlightDecant.data.image}
                                    data-brand={spotlightDecant.data.brand}
                                    data-label-rest="5 ml al carrito"
                                >
                                    5 ml al carrito
                                </button>
                                <a
                                    href={`/${spotlightDecant.data.id}`}
                                    class="quiet-btn"
                                >
                                    Ver {spotlightDecant.data.name}
                                </a>
                            </div>
                        </div>
                    </div>
                </section>
            )
        }

        <!-- Cómo se compra -->
        <section class="mx-auto max-w-[1440px] px-4 py-14 sm:px-6 lg:py-20">
            <h2 class="display text-[clamp(2rem,4.6vw,3.6rem)] text-kraft">
                Tres pasos para completar tu compra.
            </h2>
            <p class="mt-3 max-w-[52ch] text-sm leading-relaxed text-smoke">
                Sin pasarela de pago, la compra termina en una conversación por WhatsApp.
            </p>

            <ol class="mt-8 grid gap-x-10 gap-y-6 md:grid-cols-3">
                <li class="border-t border-brass/30 pt-4">
                    <span class="price block text-[2rem] text-amber">1</span>
                    <p class="mt-2 font-semibold text-kraft">
                        Eliges los decants
                    </p>
                    <p class="mt-1 max-w-[34ch] text-sm leading-relaxed text-smoke">
                        Dos o tres de 5 ml alcanzan para comparar sin gastar
                        una botella.
                    </p>
                </li>
                <li class="border-t border-brass/30 pt-4">
                    <span class="price block text-[2rem] text-amber">2</span>
                    <p class="mt-2 font-semibold text-kraft">
                        Envías el pedido
                    </p>
                    <p class="mt-1 max-w-[34ch] text-sm leading-relaxed text-smoke">
                        El pedido se abre en WhatsApp con el detalle y el total
                        ya escritos.
                    </p>
                </li>
                <li class="border-t border-brass/30 pt-4">
                    <span class="price block text-[2rem] text-amber">3</span>
                    <p class="mt-2 font-semibold text-kraft">
                        Coordinamos la entrega
                    </p>
                    <p class="mt-1 max-w-[34ch] text-sm leading-relaxed text-smoke">
                        Acordamos punto y horario contigo. Sin carrier ni plazos
                        prometidos.
                    </p>
                </li>
            </ol>

            <div
                class="mt-10 flex flex-col gap-4 border-t border-brass/25 pt-6 sm:flex-row sm:items-center sm:justify-between"
            >
                <a href="/decants" class="stamp-btn">Armar el pedido</a>
                <p class="max-w-[46ch] text-[14px] leading-snug text-brass">
                        Todo lo que se muestra en el catálogo está en stock.
                </p>
            </div>
        </section>
    </main>
</Layout>
