---
import Layout from "../layouts/MainLayout.astro";
import Navbar from "../components/Navbar.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
    const decants = await getCollection("decants");

    return decants.flatMap((decant) => {
        const props = { data: decant.data };
        return [
            { params: { name: decant.data.name }, props },
            { params: { name: decant.data.id }, props },
        ];
    });
}

const { data } = Astro.props;
const { id, name, brand, price, image, description } = data;
const key = id || name;
const clp = (value: number) => `$${value.toLocaleString("es-CL")}`;
---

<Layout
    title={`${name} · ${brand} | Essenciarabe`}
    description={`${name} de ${brand} en decant de 5 ml por ${clp(price)}. 100% original. Coordinas por WhatsApp.`}
>
    <Navbar />

    <main id="contenido" class="mx-auto max-w-[1200px] px-4 pb-16 sm:px-6">
        <div class="pt-6">
            <a href="/decants" class="quiet-btn">
                <svg
                    width="14"
                    height="14"
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    aria-hidden="true"
                >
                    <path d="M10 3L5 8l5 5"></path>
                </svg>
                Decants
            </a>
        </div>

        <div class="mt-5 grid gap-6 lg:grid-cols-[1.05fr_1fr] lg:gap-10">
            <div class="paper stock-card self-start p-3 sm:p-4">
                <div class="plate aspect-[3/4] w-full">
                    <img
                        src={image}
                        alt={name}
                        transition:name={key}
                        width="960"
                        height="1280"
                        fetchpriority="high"
                    />
                </div>
            </div>

            <div class="self-start lg:sticky lg:top-20">
                <p class="label text-brass">{brand}</p>
                <h1
                    class="display mt-2 text-[clamp(2.4rem,6vw,4.4rem)] text-kraft"
                >
                    {name}
                </h1>

                <div class="mt-5 flex flex-wrap items-baseline gap-x-4 gap-y-2">
                    <span class="price text-[clamp(2.4rem,6vw,3.6rem)] text-kraft"
                        >{clp(price)}</span
                    >
                    <span class="unit-chip border-brass/60 text-brass"
                        >5 ml</span
                    >
                </div>

                <p class="mt-5 max-w-[48ch] text-sm leading-relaxed text-smoke">
                    {description}
                </p>

                <button
                    type="button"
                    class="add-to-cart-btn stamp-btn mt-7 w-full"
                    data-id={key}
                    data-name={name}
                    data-price={price}
                    data-image={image}
                    data-brand={brand}
                    data-label-rest="Agregar al carrito"
                >
                    Agregar al carrito
                </button>

                <p class="mt-3 text-[12px] leading-snug text-brass">
                    5 ml originales. El pedido se envía por WhatsApp y coordinamos la entrega.
                </p>

            </div>
        </div>

        <!-- Estela: los últimos vistos se desvanecen -->
        <div
            class="mt-14 hidden border-t border-brass/25 pt-6"
            data-trail
            data-current={key}
            data-name={name}
            data-brand={brand}
            data-price={clp(price)}
            data-image={image}
        >
            <h2 class="label text-brass">Rastro</h2>
            <div
                class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3"
                data-trail-items
            >
            </div>
        </div>
    </main>
</Layout>
