---
import Layout from "../layouts/MainLayout.astro";
import Navbar from "../components/Navbar.astro";
import PerfumeCard from "../components/PerfumeCard.astro";

import { getCollection } from "astro:content";
const decants = await getCollection("decants");

const prices = decants.map((item) => item.data.price);
const minPrice = Math.min(...prices);
const maxPrice = Math.max(...prices);
const clp = (value: number) => `$${value.toLocaleString("es-CL")}`;
---

<Layout
    title="Decants de 5 ml | Essenciarabe"
    description={`${decants.length} decants de 5 ml de perfumes árabes originales, desde ${clp(minPrice)}. Prueba antes de comprar la botella.`}
>
    <Navbar />

    <main id="contenido" class="mx-auto max-w-[1440px] px-4 pb-16 sm:px-6">
        <header class="border-b border-brass/30 pb-5 pt-8 lg:pt-12">
            <h1 class="display text-[clamp(2.6rem,7vw,5.4rem)] text-kraft">
                Decants
            </h1>
            <div
                class="mt-4 flex flex-wrap items-baseline gap-x-6 gap-y-2 text-sm text-smoke"
            >
                <p>
                    <span class="font-semibold text-amber">{decants.length}</span>
                    fragancias en 5 ml, de {clp(minPrice)} a {clp(maxPrice)}.
                </p>
            </div>
        </header>

        {
            decants.length === 0 ? (
                <p class="py-16 text-smoke">
                    No hay decants en stock en este momento.
                </p>
            ) : (
                <div class="mt-6 grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:grid-cols-4">
                    {decants.map((product) => (
                        <PerfumeCard
                            id={product.data.id}
                            name={product.data.name}
                            brand={product.data.brand}
                            price={product.data.price}
                            image={product.data.image}
                            description={product.data.description}
                        />
                    ))}
                </div>
            )
        }
    </main>
</Layout>
